NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/electwatch?retryWrites=true&w=majority

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
JWT_REFRESH_SECRET=change-me-change-me-change-me-change-me-2
ACCESS_TTL=15m
REFRESH_TTL_DAYS=7

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Cloudinary (media uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Shared secret your SMS/voice provider sends with webhooks (header x-webhook-secret)
WEBHOOK_SECRET=change-me-webhook-secret

# SMS: console (logs only) | termii
SMS_PROVIDER=console
TERMII_API_KEY=
TERMII_SENDER_ID=

# First admin, used by `npm run seed`
SEED_ADMIN_EMAIL=admin@electwatch.local
SEED_ADMIN_PASSWORD=ChangeThisNow!2027
